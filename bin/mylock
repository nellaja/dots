#!/usr/bin/env bash

# My standard bash script defaults
set -euo pipefail
IFS=$'\n\t'
clear

# Insert script below

TIMEOUT=300

case "$1" in
  # Turns off swayidle to make KVM switching easier
  lock-off)
    pkill swayidle || true
    ;;
  # Turns back on default swayidle settings
  enable-lock|*)
    pkill swayidle || true
    swayidle -w \
      timeout $TIMEOUT 'swaylock -f -e -i ~/wallpaper_lock.png -s fill' \
      timeout $(( TIMEOUT * 2 )) 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
    ;;
esac
