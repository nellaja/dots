#!/usr/bin/env bash

# Check release
if [ ! -f /etc/arch-release ]; then
  exit 0
fi

pkg_installed() {
  local pkg=$1

  if pacman -Qi "${pkg}" &>/dev/null; then
    return 0
  elif command -v "${pkg}" &>/dev/null; then
    return 0
  else
    return 1
  fi
}

get_aur_helper() {
  if pkg_installed yay; then
    aur_helper="yay"
  elif pkg_installed paru; then
    aur_helper="paru"
  fi
}

get_aur_helper

# Check for AUR updates
if [ -n "$aur_helper" ]; then
  aur_updates=$(${aur_helper} -Qua | grep -c '^')
else
  aur_updates=0
fi

# Check for official repository updates
official_updates=$(
  (while pgrep -x checkupdates >/dev/null; do sleep 1; done)
  checkupdates | grep -c '^'
)


# Calculate total available updates
total_updates=$((official_updates + aur_updates))

# Create tooltip
tooltip="Official:  $official_updates\nAUR ($aur_helper): $aur_updates"

# Module and tooltip
if [ $total_updates -ne 0 ]; then
  echo "{\"text\":\"󰮯\", \"tooltip\":\"${tooltip//\"/\\\"}\", \"class\":\"updates\"}"
else
  echo "{\"text\":\"󰮯\", \"tooltip\":\"Packages are up to date\"}"
fi
