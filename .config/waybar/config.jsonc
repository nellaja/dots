// =============================================================================
//
// Waybar configuration
//
// Configuration reference: https://github.com/Alexays/Waybar/wiki/Configuration
//
// =============================================================================

{
    // -------------------------------------------------------------------------
    // Global configuration
    // -------------------------------------------------------------------------

    "layer": "bottom",
    "position": "top",
    "height": 49,
    "spacing": 0,

    "modules-left": [
    //    "custom/distro",            
        "image#distro",
        "sway/workspaces",
        "sway/scratchpad",
        "sway/window",
        "sway/mode",
    ],
    "modules-center": [
        "clock",
    ],
    "modules-right": [
        "pulseaudio",
        "bluetooth",
        "network",
        "custom/pacman",
        "custom/idle",
        "custom/power",
    ],


    // -------------------------------------------------------------------------
    // Modules
    // -------------------------------------------------------------------------

    "image#distro": {
        "path": "/home/aj/TX.png",
        "size": 29,
        "interval": 16807,
        "on-click": "fuzzel",
        "tooltip": false,
    },

    "sway/workspaces": {
    },

    "sway/scratchpad": {
        "format": "{icon}  {count}",
        "show-empty": false,
        "format-icons": [""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
   
    "sway/window": {
        "format": "{app_id}",
        "min-length": 5,
        "max-length": 120,
        "rewrite": {

            // == Terminal ==

            "foot": 
            "<span foreground='#4589ff'> </span>  Foot",

            // == Browser ==

            "firefox": 
            "<span foreground='#4589ff'> </span>  Firefox",
            "librewolf": 
            "<span foreground='#4589ff'> </span>  Librewolf",

            // == Media ==

            "gimp(.*)": 
            "<span foreground='#4589ff'> </span>  Gimp",
        }
    },

    "sway/mode": {
        "format": "{}", 
        "tooltip": false
    },

    "clock": {
      "format": "{:%a  %b %d  %R}", 
      "tooltip": false,
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["","",""],
            "headphone": "",
            "headset": ""
        },
        "tooltip": true,
        "tooltip-format": "Device: {desc}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
    },
    
    "bluetooth": {
        "format": "󰂰",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "tooltip-format": 
            "{num_connections} connected",
        "tooltip-format-disabled": 
            "Bluetooth Disabled",
        "tooltip-format-connected": 
            "{num_connections} connected{device_enumerate}",
        "tooltip-format-enumerate-connected": 
            "{device_alias}",
        "tooltip-format-enumerate-connected-battery": 
            "{device_alias}: {device_battery_percentage}%",
        "interval": 1,
    },

    "network": {
        "format-wifi": "󰖩", // Icon: wifi
        "format-ethernet":"", // Icon: ethernet
        "format-disconnected": "",
        "tooltip-format": "{ifname}: {ipaddr} (speed: {bandwidthDownBytes})"
    },

    "custom/pacman": {
        "exec": "pacman-update",
        "return-type": "json",
        "format": "{}",
        "interval": 600,
        "tooltip": true,
    },
    
    "custom/idle": {
        "exec": "idle-control status",
        "interval": "once",
        "signal": 7,
        "return-type": "json",
        "tooltip": true,
        "format": "{}",
        "on-click": "idle-control toggle"
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "power-menu"
    }
}
